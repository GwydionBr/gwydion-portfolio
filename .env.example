# Reference only: secrets live in Infisical (see README) and are injected
# via `infisical run`. Enter values in Infisical without surrounding quotes.

# Resend – email delivery for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=re_...

# Sender must use a domain verified in Resend
CONTACT_FROM_EMAIL="Portfolio Contact <contact@mail.gwydion.dev>"
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=you@example.com
