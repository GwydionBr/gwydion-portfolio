{
  "name": "gwydion-portfolio",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "infisical run --env=dev --silent -- vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "prepare": "vp config",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "bun scripts/check-catalogs.ts",
    "screenshots:sync": "bun scripts/sync-self-engine-screenshots.ts",
    "check": "bun run i18n:check && vp check",
    "check:fix": "vp check --fix && bun run i18n:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@mdx-js/rollup": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/native-tools": "0.1.6",
    "@lingui/vite-plugin": "6.10.1",
    "@messageformat/parser": "5.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
